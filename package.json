{
  "name": "jjak",
  "private": true,
  "version": "1.0.0",
  "description": "Jjak (짝) — a calm pair-connecting puzzle built on the flower-card deck Korea and Japan share.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/subset-fonts.mjs",
    "assets": "capacitor-assets generate --android --assetPath resources",
    "android:sync": "npm run build && cap sync android",
    "screens": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
